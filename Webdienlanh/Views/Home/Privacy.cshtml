@{
    ViewData["Title"] = "Chính Sách & Quy Định - BPV STORE";
}

<!-- FONT CHUẨN QUỐC TẾ -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    
    /* ================= BANNER TỐI THƯỢNG ================= */
    .hero-banner-mini {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 24px; padding: 4rem 2rem; position: relative; overflow: hidden;
        margin-top: 1.5rem; margin-bottom: 4rem; text-align: center;
        box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.2);
    }
    .hero-banner-mini::before {
        content: ''; position: absolute; top: -50%; right: 10%; width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.25) 0%, transparent 70%); border-radius: 50%;
    }

    /* ================= BENTO GRID POLICY CARDS ================= */
    .policy-card {
        background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; padding: 2.5rem;
        height: 100%; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05); position: relative; overflow: hidden;
    }
    .policy-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px -10px rgba(37, 99, 235, 0.15); border-color: #cbd5e1; }
    
    .policy-icon-wrapper {
        width: 64px; height: 64px; border-radius: 20px; display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; margin-bottom: 1.5rem; transition: all 0.3s ease; flex-shrink: 0;
    }
    .policy-card:hover .policy-icon-wrapper { transform: scale(1.1) rotate(-5deg); }

    /* ================= CUSTOM LIST ================= */
    .custom-list { list-style: none; padding-left: 0; margin-top: 1.5rem; margin-bottom: 0; }
    .custom-list li { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; color: #475569; font-weight: 500; line-height: 1.6; }
    .custom-list li:last-child { margin-bottom: 0; }
    .custom-list li i { font-size: 1.2rem; flex-shrink: 0; margin-top: 2px; }

    /* ================= CTA CHUYÊN NGHIỆP ================= */
    .cta-super-block {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border-radius: 24px; padding: 4rem 2rem; position: relative; overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(37, 99, 235, 0.4); text-align: center; color: white;
    }
    .cta-super-block::after {
        content: ''; position: absolute; bottom: -30%; left: 50%; transform: translateX(-50%);
        width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%); border-radius: 50%;
    }
    .btn-cta {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); border: none; font-size: 1.1rem; padding: 14px 36px;
    }
    .btn-cta:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 15px 30px rgba(0,0,0,0.2); }
</style>

<div class="container py-4 pb-5">
    <!-- BANNER -->
    <div class="hero-banner-mini">
        <div class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-10 rounded-4 mb-4" style="width: 72px; height: 72px; border: 1px solid rgba(255,255,255,0.1);">
            <i class="bi bi-shield-check fs-1 text-info"></i>
        </div>
        <h1 class="fw-black text-white mb-3 display-6" style="font-weight: 900;">Chính Sách & Cam Kết Dịch Vụ</h1>
        <p class="fs-5 text-light opacity-75 mb-0 mx-auto fw-medium" style="max-width: 700px;">Chúng tôi luôn đặt quyền lợi, sự an tâm và trải nghiệm của khách hàng lên hàng đầu.</p>
    </div>

    <!-- BENTO GRID CHÍNH SÁCH -->
    <div class="row g-4 mb-5">
        <!-- Card 1: Bảo mật thông tin -->
        <div class="col-lg-6">
            <div class="policy-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="policy-icon-wrapper bg-primary text-white shadow-sm"><i class="bi bi-lock-fill"></i></div>
                    <h4 class="fw-bold text-dark mb-0">1. Chính Sách Bảo Mật</h4>
                </div>
                <p class="text-muted fw-medium mb-0">Mọi thông tin cá nhân của quý khách (Họ tên, số điện thoại, địa chỉ nhà riêng hoặc văn phòng) khi đặt lịch sửa chữa, vệ sinh máy lạnh đều được cam kết bảo mật tuyệt đối.</p>
                <ul class="custom-list">
                    <li><i class="bi bi-check2-circle text-primary"></i> Không chia sẻ cho bên thứ ba dưới mọi hình thức.</li>
                    <li><i class="bi bi-check2-circle text-primary"></i> Chỉ sử dụng để liên hệ điều phối thợ kỹ thuật và chăm sóc khách hàng.</li>
                </ul>
            </div>
        </div>

        <!-- Card 2: Bảo hành dịch vụ -->
        <div class="col-lg-6">
            <div class="policy-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="policy-icon-wrapper bg-success text-white shadow-sm"><i class="bi bi-patch-check-fill"></i></div>
                    <h4 class="fw-bold text-dark mb-0">2. Bảo Hành Dịch Vụ</h4>
                </div>
                <p class="text-muted fw-medium mb-0">Chúng tôi cung cấp chính sách bảo hành dài hạn và uy tín cho tất cả các dịch vụ điện lạnh tại khu vực Thủ Dầu Một:</p>
                <ul class="custom-list">
                    <li><i class="bi bi-check2-circle text-success"></i> <strong>Vệ sinh máy lạnh:</strong> Bảo hành chảy nước trong vòng 7 ngày.</li>
                    <li><i class="bi bi-check2-circle text-success"></i> <strong>Bơm gas & Sửa chữa:</strong> Bảo hành linh kiện và kỹ thuật từ 3 đến 6 tháng.</li>
                    <li><i class="bi bi-check2-circle text-success"></i> <strong>Lắp đặt mới:</strong> Bảo hành kỹ thuật lắp đặt lên đến 12 tháng.</li>
                </ul>
            </div>
        </div>

        <!-- Card 3: Báo giá & Thanh toán -->
        <div class="col-lg-6">
            <div class="policy-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="policy-icon-wrapper bg-warning text-dark shadow-sm"><i class="bi bi-wallet2"></i></div>
                    <h4 class="fw-bold text-dark mb-0">3. Báo Giá & Thanh Toán</h4>
                </div>
                <p class="text-muted fw-medium mb-0">Minh bạch chi phí là phương châm hoạt động cốt lõi của chúng tôi:</p>
                <ul class="custom-list">
                    <li><i class="bi bi-check2-circle text-warning"></i> Thợ khảo sát tình trạng thực tế và báo giá chi tiết <strong>trước khi tiến hành sửa chữa</strong>.</li>
                    <li><i class="bi bi-check2-circle text-warning"></i> Khách hàng chỉ thanh toán khi máy lạnh hoạt động ổn định và hài lòng.</li>
                    <li><i class="bi bi-check2-circle text-warning"></i> Hỗ trợ thanh toán linh hoạt qua tiền mặt hoặc chuyển khoản.</li>
                </ul>
            </div>
        </div>

        <!-- Card 4: Khiếu nại -->
        <div class="col-lg-6">
            <div class="policy-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="policy-icon-wrapper bg-danger text-white shadow-sm"><i class="bi bi-headset"></i></div>
                    <h4 class="fw-bold text-dark mb-0">4. Tiếp Nhận & Khiếu Nại</h4>
                </div>
                <p class="text-muted fw-medium mb-0">Mọi ý kiến đóng góp hoặc phản hồi về thái độ phục vụ của kỹ thuật viên, quý khách vui lòng liên hệ:</p>
                <ul class="custom-list">
                    <li><i class="bi bi-telephone-fill text-danger"></i> <strong>Hotline hỗ trợ nhanh:</strong> 0866450439</li>
                    <li><i class="bi bi-envelope-fill text-danger"></i> <strong>Email tiếp nhận:</strong> support@bpvstore.vn</li>
                    <li><i class="bi bi-clock-fill text-danger"></i> Thời gian xử lý khiếu nại trong vòng 24 giờ kể từ khi nhận được thông tin.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- KHỐI CTA ĐÃ ĐƯỢC NÂNG CẤP (Dựa trên code gốc của bạn) -->
    <div class="cta-super-block">
        <div class="position-relative z-2">
            <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3 backdrop-blur" style="width: 70px; height: 70px;">
                <i class="bi bi-telephone-inbound-fill fs-2"></i>
            </div>
            <h2 class="fw-black mb-3 display-6" style="font-weight: 800;">Bạn cần hỗ trợ trực tiếp?</h2>
            <p class="mb-4 text-light fw-medium fs-5 opacity-75" style="max-width: 600px; margin: 0 auto;">Đội ngũ kỹ thuật viên chuyên nghiệp của BPV Store luôn sẵn sàng phục vụ quý khách 24/7.</p>
            <a href="tel:0866450439" class="btn btn-light btn-cta rounded-pill fw-bold text-primary shadow">
                <i class="bi bi-telephone-fill me-2"></i> Gọi Ngay: 0866450439
            </a>
        </div>
    </div>
</div>
@model IEnumerable<Webdienlanh.Models.BookingOrder>

@{
    ViewData["Title"] = "Quản Lý Đơn Đặt Lịch";
}

<div class="container py-4">
    <div class="bg-dark text-white p-4 rounded-4 shadow-sm mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-clipboard-data"></i> Danh Sách Khách Hàng Đặt Lịch</h2>
            <p class="text-secondary mb-0">Quản lý toàn bộ yêu cầu sửa chữa và bảo trì từ website.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm">Về Trang Chủ</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Họ Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Địa Chỉ</th>
                        <th>Dịch Vụ Đăng Ký</th>
                        <th>Thời Gian Thợ Đến</th>
                        <th>Ghi Chú</th>
                        <th>Thời Gian Đặt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có đơn đặt lịch nào được ghi nhận.</td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@(i++)</td>
                                <td class="fw-semibold text-primary">@item.CustomerName</td>
                                <td><i class="bi bi-telephone-fill text-success me-1"></i> @item.Phone</td>
                                <td>@item.Address</td>
                                <td>
                                    <span class="badge bg-info text-dark">@item.SelectedServices</span>
                                </td>
                                <td><i class="bi bi-clock me-1 text-danger"></i> @item.ServiceDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Notes) ? "Không có" : item.Notes)</td>
                                <td class="small text-secondary">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
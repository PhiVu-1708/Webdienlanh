@model IEnumerable<Webdienlanh.Models.BookingOrder>
@{
    ViewData["Title"] = "Tra Cứu Dịch Vụ Thông Minh";
}

<style>
    /* ================= GIAO DIỆN TỐI THƯỢNG (ULTIMATE UI) ================= */
    body { background-color: #f4f7fe; font-family: 'Inter', 'Segoe UI', sans-serif; }
    
    /* Hiệu ứng mượt mà */
    .hover-lift { transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
    .hover-lift:hover { transform: translateY(-4px); box-shadow: 0 15px 30px rgba(13, 110, 253, 0.15); }
    
    /* Box Tìm Kiếm Glassmorphism */
    .search-wrapper {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
    }

    /* Card Đơn Hàng */
    .ultimate-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 10px 40px rgba(22, 28, 45, 0.05);
        border: none;
        overflow: hidden;
    }

    /* Thanh Tiến Độ Hiện Đại */
    .tracker-container { position: relative; padding: 0 15px; margin-top: 30px; margin-bottom: 40px; }
    .tracker-track {
        position: absolute; top: 22px; left: 10%; right: 10%;
        height: 6px; background-color: #e2e8f0; border-radius: 10px; z-index: 1;
    }
    .tracker-fill {
        height: 100%; border-radius: 10px; background: linear-gradient(90deg, #0d6efd, #0dcaf0);
        transition: width 0.8s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    .step-node {
        width: 50px; height: 50px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #fff; border: 4px solid #e2e8f0; z-index: 2; position: relative;
        transition: all 0.4s ease; box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .step-node.active { border-color: #0d6efd; color: #0d6efd; box-shadow: 0 0 0 6px rgba(13, 110, 253, 0.15); }
    .step-node.completed { border-color: #198754; background: #198754; color: #fff; }

    /* Animation */
    .pulse-glow { animation: pulse-glow-anim 2s infinite; }
    @@keyframes pulse-glow-anim {
        0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4); }
        70% { box-shadow: 0 0 0 12px rgba(13, 110, 253, 0); }
        100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
    }
    .moving-truck { animation: drive 2.5s ease-in-out infinite; }
    @@keyframes drive {
        0% { transform: translateX(-15px) rotate(-2deg); opacity: 0; }
        30% { transform: translateX(5px) rotate(0deg); opacity: 1; }
        70% { transform: translateX(25px) rotate(0deg); opacity: 1; }
        100% { transform: translateX(45px) rotate(2deg); opacity: 0; }
    }

    /* Banner "Đang Đến" */
    .eta-banner { background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border: 1px solid #bae6fd; }
    
    /* Nút bấm tinh chỉnh */
    .btn-super { border-radius: 12px; font-weight: 700; padding: 10px 20px; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.85rem; }
</style>

<div class="container py-5">
    <!-- KHU VỰC TÌM KIẾM HERO -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-7 col-md-9 text-center">
            <div class="d-inline-block bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 rounded-pill mb-3 small">
                <i class="bi bi-shield-check me-1"></i> Hệ thống theo dõi thời gian thực
            </div>
            <h2 class="fw-black text-dark mb-3" style="font-weight: 900; letter-spacing: -1px; font-size: 2.2rem;">
                Tra Cứu Dịch Vụ
            </h2>
            <p class="text-muted fw-semibold mb-4">Theo dõi toàn bộ quá trình xử lý đơn hàng và vị trí của thợ sửa chữa một cách trực quan.</p>

            <form asp-controller="Home" asp-action="TrackOrder" method="get" class="search-wrapper d-flex align-items-center rounded-pill p-2 mx-auto">
                <div class="ps-3 pe-2 text-muted"><i class="bi bi-telephone-fill fs-5"></i></div>
                <input type="text" name="phone" class="form-control border-0 bg-transparent shadow-none fw-bold text-dark fs-6" placeholder="Nhập số điện thoại..." value="@ViewBag.SearchedPhone" required pattern="[0-9]{10,11}">
                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold hover-lift shadow-sm">
                    Tra cứu <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- KẾT QUẢ TRA CỨU -->
    @if (Model != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                @if (!Model.Any())
                {
                    <div class="ultimate-card text-center p-5 border-0">
                        <img src="https://cdn-icons-png.flaticon.com/512/7486/7486747.png" alt="Not Found" style="width: 120px; opacity: 0.6; margin-bottom: 20px;">
                        <h4 class="fw-bold text-dark">Chưa có chuyến đi nào</h4>
                        <p class="text-muted mb-0">Hệ thống chưa ghi nhận đơn dịch vụ nào cho số điện thoại <strong class="text-primary">@ViewBag.SearchedPhone</strong>.</p>
                    </div>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <div class="ultimate-card mb-5 hover-lift">
                            <!-- Header -->
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 px-md-5 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                                <div>
                                    <h4 class="fw-black text-dark mb-1" style="font-weight: 800;"><i class="bi bi-gear-wide-connected text-primary me-2"></i> @item.SelectedServices</h4>
                                    <div class="text-muted small fw-semibold d-flex align-items-center">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @item.Address
                                    </div>
                                </div>
                                <div class="bg-light border px-3 py-2 rounded-pill shadow-sm text-dark fw-bold small">
                                    <i class="bi bi-calendar-event text-primary me-1"></i> @item.ServiceDate.ToString("HH:mm - dd/MM/yyyy")
                                </div>
                            </div>

                            <div class="card-body p-4 p-md-5 pt-4">
                                
                                <!-- THANH TIẾN ĐỘ THÔNG MINH -->
                                <div class="tracker-container">
                                    <div class="tracker-track">
                                        @{
                                            string fillWidth = "0%";
                                            if (item.Status == 1) fillWidth = "33.33%";
                                            if (item.Status == 2) fillWidth = "66.66%";
                                            if (item.Status == 3) fillWidth = "100%";
                                        }
                                        <div class="tracker-fill" style="width: @fillWidth;"></div>
                                    </div>

                                    <div class="d-flex justify-content-between position-relative">
                                        <!-- Step 1 -->
                                        <div class="d-flex flex-column align-items-center" style="width: 70px;">
                                            <div class="step-node @(item.Status >= 0 ? (item.Status > 0 ? "completed" : "active pulse-glow") : "")">
                                                <i class="bi @(item.Status > 0 ? "bi-check-lg" : "bi-receipt") fs-5"></i>
                                            </div>
                                            <span class="small fw-bold mt-2 text-dark text-center" style="font-size: 0.75rem;">Đã nhận</span>
                                        </div>

                                        <!-- Step 2 -->
                                        <div class="d-flex flex-column align-items-center" style="width: 70px;">
                                            <div class="step-node @(item.Status >= 1 ? (item.Status > 1 ? "completed" : "active pulse-glow") : "text-muted")">
                                                <i class="bi @(item.Status > 1 ? "bi-check-lg" : "bi-person-check") fs-5"></i>
                                            </div>
                                            <span class="small fw-bold mt-2 @(item.Status >= 1 ? "text-dark" : "text-muted") text-center" style="font-size: 0.75rem;">Có thợ</span>
                                        </div>

                                        <!-- Step 3 -->
                                        <div class="d-flex flex-column align-items-center" style="width: 70px;">
                                            <div class="step-node @(item.Status >= 2 ? (item.Status > 2 ? "completed" : "active pulse-glow") : "text-muted")">
                                                <i class="bi @(item.Status > 2 ? "bi-check-lg" : "bi-truck") fs-5"></i>
                                            </div>
                                            <span class="small fw-bold mt-2 @(item.Status >= 2 ? "text-dark" : "text-muted") text-center" style="font-size: 0.75rem;">Đang đến</span>
                                        </div>

                                        <!-- Step 4 -->
                                        <div class="d-flex flex-column align-items-center" style="width: 70px;">
                                            <div class="step-node @(item.Status == 3 ? "completed pulse-glow" : "text-muted")">
                                                <i class="bi bi-patch-check-fill fs-5"></i>
                                            </div>
                                            <span class="small fw-bold mt-2 @(item.Status == 3 ? "text-success" : "text-muted") text-center" style="font-size: 0.75rem;">Hoàn thành</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="clearfix mb-4"></div>

                                <!-- GHI CHÚ -->
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <div class="bg-light p-3 rounded-4 small fw-semibold text-dark border shadow-sm mb-4">
                                        <i class="bi bi-chat-left-text-fill text-warning me-2"></i><strong>Ghi chú:</strong> @item.Notes
                                    </div>
                                }

                                <!-- GIAO DIỆN BANNER KHI THỢ ĐANG ĐẾN -->
                                @if (item.Status == 2)
                                {
                                    <div class="eta-banner rounded-4 p-3 mb-4 d-flex flex-column flex-sm-row align-items-center justify-content-between shadow-sm">
                                        <div class="d-flex align-items-center mb-3 mb-sm-0 w-100">
                                            <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm me-3 flex-shrink-0" style="width: 56px; height: 56px;">
                                                <i class="bi bi-truck text-primary fs-3 moving-truck d-inline-block"></i>
                                            </div>
                                            <div class="text-start flex-grow-1">
                                                <h6 class="text-primary fw-black mb-1" style="font-size: 1.1rem; letter-spacing: -0.3px;">Thợ đang trên đường!</h6>
                                                <span class="small text-muted fw-semibold d-block d-sm-none">Dự kiến tới: <span class="text-success fw-bold">15 - 20 Phút</span></span>
                                                <span class="small text-muted fw-semibold d-none d-sm-block">Vui lòng chú ý điện thoại.</span>
                                            </div>
                                        </div>
                                        
                                        <div class="bg-white text-dark fw-bold rounded-pill px-4 py-2 shadow-sm border border-light text-nowrap d-none d-sm-block">
                                            <i class="bi bi-stopwatch text-warning fs-5 align-middle me-1"></i> <span class="text-success fs-6">15 - 20 Phút</span>
                                        </div>
                                    </div>
                                }

                                <!-- CARD THÔNG TIN THỢ (HIỆN KHI STATUS = 1 HOẶC 2) -->
                                @if (item.Status >= 1 && item.Status < 3 && ViewBag.Technicians != null)
                                {
                                    var techs = ViewBag.Technicians as IEnumerable<Webdienlanh.Models.Technician>;
                                    var currentTech = techs?.FirstOrDefault(t => t.Id == item.TechnicianId);
                                    
                                    if (currentTech != null)
                                    {
                                        <div class="bg-white p-4 rounded-4 border border-2 border-primary border-opacity-10 d-flex flex-column flex-md-row align-items-md-center justify-content-between shadow-sm gap-3">
                                            <div class="d-flex align-items-center">
                                                <div class="position-relative me-3">
                                                    <img src="https://ui-avatars.com/api/?name=@currentTech.FullName&background=0D6EFD&color=fff&rounded=true&size=60&bold=true" class="shadow-sm rounded-circle" alt="Avatar">
                                                    <span class="position-absolute bottom-0 end-0 bg-success border border-2 border-white rounded-circle" style="width: 14px; height: 14px; margin-bottom: 3px; margin-right: 3px;"></span>
                                                </div>
                                                <div>
                                                    <span class="badge bg-primary bg-opacity-10 text-primary mb-1">Thợ Phụ Trách</span>
                                                    <h5 class="text-dark fw-bold mb-0">@currentTech.FullName <i class="bi bi-patch-check-fill text-primary" title="Đã xác thực"></i></h5>
                                                </div>
                                            </div>
                                            
                                            <div class="d-flex gap-2 w-100" style="max-width: 300px;">
                                                <button type="button" class="btn btn-light btn-super border text-primary flex-fill hover-lift shadow-sm" onclick="openChatModal(@item.Id, 'Customer')">
                                                    <i class="bi bi-chat-dots-fill me-1"></i> Nhắn tin
                                                </button>
                                                <a href="tel:@currentTech.Phone" class="btn btn-primary btn-super text-white flex-fill hover-lift shadow-sm pulse-glow">
                                                    <i class="bi bi-telephone-fill me-1"></i> Gọi ngay
                                                </a>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<!-- ================= MODAL CHAT IN-APP TỐI THƯỢNG ================= -->
<div class="modal fade" id="chatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 p-3" style="background: linear-gradient(135deg, #0d6efd, #0dcaf0);">
                <div class="d-flex align-items-center">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px;">
                        <i class="bi bi-headset text-primary fs-4"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold mb-0 text-white fs-5">Hỗ trợ trực tuyến</h6>
                        <small class="text-white-50 fw-semibold"><i class="bi bi-circle-fill text-white" style="font-size: 0.5rem; animation: pulse-glow-anim 2s infinite;"></i> Thợ đang trực tuyến</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="closeChatModal()"></button>
            </div>
            
            <!-- Chat Box với thanh cuộn ẩn -->
            <div class="modal-body p-4" style="background-color: #f8fafc; height: 420px; overflow-y: auto;" id="chatBox">
                <!-- Data Chat -->
            </div>
            
            <div class="modal-footer bg-white border-top p-3 shadow-lg">
                <form id="chatForm" class="d-flex w-100 gap-2" onsubmit="sendChatMessage(event)">
                    <input type="hidden" id="chatOrderId" />
                    <input type="hidden" id="chatSenderRole" value="Customer" />
                    <div class="input-group bg-light rounded-pill p-1 border shadow-sm w-100 d-flex align-items-center">
                        <input type="text" id="chatInputText" class="form-control border-0 bg-transparent shadow-none px-4 fw-semibold" placeholder="Soạn tin nhắn..." required autocomplete="off">
                        <button type="submit" class="btn btn-primary rounded-circle shadow d-flex align-items-center justify-content-center me-1" style="width: 42px; height: 42px; transition: transform 0.2s;">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    let activeOrderId = 0;
    let chatInterval = null;

    function openChatModal(orderId, role) {
        activeOrderId = orderId;
        document.getElementById('chatOrderId').value = orderId;
        document.getElementById('chatSenderRole').value = role;

        if (chatInterval) clearInterval(chatInterval);
        loadMessages();
        new bootstrap.Modal(document.getElementById('chatModal')).show();
        
        // Polling tin nhắn mỗi 2 giây
        chatInterval = setInterval(() => { if (activeOrderId === orderId) loadMessages(); }, 2000);
    }

    function closeChatModal() {
        if (chatInterval) clearInterval(chatInterval);
        activeOrderId = 0;
    }

    function loadMessages() {
        if (!activeOrderId) return;
        fetch('/Chat/GetMessages?orderId=' + activeOrderId)
            .then(res => res.json())
            .then(data => {
                let box = document.getElementById('chatBox');
                let currentRole = document.getElementById('chatSenderRole').value;
                box.innerHTML = '';

                if (!data || data.length === 0) {
                    box.innerHTML = `
                        <div class="text-center mt-5">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-chat-heart text-primary" style="font-size: 2.5rem;"></i>
                            </div>
                            <h6 class="text-dark fw-bold">Hãy bắt đầu cuộc trò chuyện!</h6>
                            <p class="text-muted small">Thợ đang chờ tin nhắn từ bạn.</p>
                        </div>`;
                    return;
                }

                data.forEach(m => {
                    let isMe = m.senderRole === currentRole;
                    let wrap = isMe ? 'justify-content-end' : 'justify-content-start';
                    let bg = isMe ? 'bg-primary text-white shadow-sm' : 'bg-white text-dark border shadow-sm';
                    let timeAlign = isMe ? 'text-end' : 'text-start';

                    box.innerHTML += `
                        <div class="d-flex w-100 ${wrap} mb-3">
                            <div style="max-width: 80%;">
                                <div class="p-3 ${bg}" style="border-radius: 1.25rem; ${isMe ? 'border-bottom-right-radius: 4px;' : 'border-bottom-left-radius: 4px;'}">
                                    ${m.messageText}
                                </div>
                                <div class="small text-muted mt-1 ${timeAlign}" style="font-size: 0.7rem; font-weight: 600;">
                                    ${m.sentAt}
                                </div>
                            </div>
                        </div>`;
                });
                box.scrollTop = box.scrollHeight;
            });
    }

    function sendChatMessage(e) {
        e.preventDefault();
        let input = document.getElementById('chatInputText');
        if (!input.value.trim()) return;

        let formData = new FormData();
        formData.append('orderId', activeOrderId);
        formData.append('senderRole', document.getElementById('chatSenderRole').value);
        formData.append('messageText', input.value.trim());

        // Effect nút gửi
        let btn = e.target.querySelector('button[type="submit"]');
        btn.style.transform = 'scale(0.9)';
        setTimeout(() => btn.style.transform = 'scale(1)', 150);

        fetch('/Chat/SendMessage', { method: 'POST', body: formData }).then(res => res.json()).then(res => {
            if (res.success) { input.value = ''; loadMessages(); } 
        });
    }
</script>
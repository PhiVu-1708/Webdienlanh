@{
    ViewData["Title"] = "Quy Trình Dịch Vụ - BPV STORE";
}

<!-- FONT CHUẨN QUỐC TẾ -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    
    /* ================= BANNER ================= */
    .hero-banner-mini {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 24px; padding: 4rem 2rem; position: relative; overflow: hidden;
        margin-top: 1.5rem; margin-bottom: 5rem; text-align: center;
        box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.2);
    }
    .hero-banner-mini::before {
        content: ''; position: absolute; top: -50%; right: 10%; width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.25) 0%, transparent 70%); border-radius: 50%;
    }

    /* ================= TIMELINE SAAS CHUYÊN NGHIỆP ================= */
    .timeline-container { position: relative; max-width: 900px; margin: 0 auto; padding-left: 2rem; }
    
    /* Trục dọc nét đứt */
    .timeline-container::before {
        content: ''; position: absolute; top: 0; left: 32px; height: 100%; width: 2px;
        background: repeating-linear-gradient(to bottom, #cbd5e1 0, #cbd5e1 10px, transparent 10px, transparent 20px);
    }

    .timeline-step { position: relative; margin-bottom: 3.5rem; width: 100%; padding-left: 4.5rem; }
    .timeline-step:last-child { margin-bottom: 0; }

    /* Icon từng bước */
    .timeline-icon {
        position: absolute; left: -18px; top: 0; width: 64px; height: 64px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: 800;
        background: white; border: 4px solid var(--step-color); color: var(--step-color);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08); z-index: 2; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Thẻ nội dung */
    .timeline-card {
        background: white; border: 1px solid #e2e8f0; border-radius: 20px; padding: 2.5rem;
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05); transition: all 0.4s ease;
        position: relative; overflow: hidden;
    }
    
    /* Vệt màu đánh dấu bên trái thẻ */
    .timeline-card::before {
        content: ''; position: absolute; left: 0; top: 0; height: 100%; width: 6px;
        background: var(--step-color); transition: width 0.3s ease;
    }

    .timeline-step:hover .timeline-icon { 
        transform: scale(1.15) rotate(5deg); background: var(--step-color); color: white;
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }
    .timeline-step:hover .timeline-card {
        transform: translateX(8px); box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1); border-color: #cbd5e1;
    }

    /* ================= CUSTOM LIST ================= */
    .step-list { list-style: none; padding-left: 0; margin-top: 1.25rem; margin-bottom: 0; }
    .step-list li { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; color: #475569; font-weight: 500; line-height: 1.6; }
    .step-list li:last-child { margin-bottom: 0; }
    .step-list li i { font-size: 1.2rem; flex-shrink: 0; margin-top: 2px; color: var(--step-color); }

    /* ================= CTA CHUYÊN NGHIỆP ================= */
    .cta-super-block {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border-radius: 24px; padding: 4rem 2rem; position: relative; overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(37, 99, 235, 0.4); text-align: center; color: white;
        margin-top: 5rem;
    }
    .cta-super-block::after {
        content: ''; position: absolute; top: -50%; right: -10%; width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%); border-radius: 50%;
    }
    .btn-cta {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); border: none; font-size: 1.1rem; padding: 16px 40px;
    }
    .btn-cta:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 20px 40px rgba(0,0,0,0.25); }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .timeline-container { padding-left: 0; }
        .timeline-container::before { left: 24px; }
        .timeline-step { padding-left: 4.5rem; margin-bottom: 2.5rem; }
        .timeline-icon { left: -8px; width: 50px; height: 50px; font-size: 1.4rem; border-width: 3px; }
        .timeline-card { padding: 1.5rem; }
    }
</style>

<div class="container py-4 pb-5">
    <!-- BANNER -->
    <div class="hero-banner-mini">
        <span class="badge bg-primary bg-opacity-25 text-info px-4 py-2 rounded-pill fw-bold text-uppercase mb-4" style="letter-spacing: 2px;">Minh Bạch - Chuyên Nghiệp</span>
        <h1 class="fw-black text-white mb-4 display-5" style="font-weight: 900;">Quy Trình Làm Việc Tại BPV Store</h1>
        <p class="fs-5 text-light opacity-75 mb-0 mx-auto fw-medium" style="max-width: 800px;">Chúng tôi áp dụng quy trình chuẩn 4 bước nhằm mang lại trải nghiệm dịch vụ tốt nhất, đảm bảo tính minh bạch về giá cả và chất lượng cho mọi khách hàng.</p>
    </div>

    <!-- TIMELINE -->
    <div class="timeline-container">
        
        <!-- BƯỚC 1 -->
        <div class="timeline-step" style="--step-color: #2563eb;"> <!-- Primary Blue -->
            <div class="timeline-icon"><i class="bi bi-headset"></i></div>
            <div class="timeline-card">
                <h3 class="fw-bold mb-3" style="color: #2563eb;">Bước 1: Tiếp Nhận Thông Tin & Đặt Lịch</h3>
                <p class="text-muted fw-medium mb-3">Khách hàng liên hệ với BPV Store thông qua Website, Hotline hoặc Zalo. Đội ngũ CSKH sẽ nhanh chóng phản hồi:</p>
                <ul class="step-list">
                    <li><i class="bi bi-check-circle-fill"></i> Ghi nhận tình trạng hư hỏng của máy lạnh (không lạnh, chảy nước, kêu to...).</li>
                    <li><i class="bi bi-check-circle-fill"></i> Ghi nhận địa chỉ và thời gian khách hàng mong muốn sửa chữa.</li>
                    <li><i class="bi bi-check-circle-fill"></i> Điều phối thợ kỹ thuật gần khu vực Thủ Dầu Một di chuyển đến nhà khách hàng trong vòng 30 phút.</li>
                </ul>
            </div>
        </div>

        <!-- BƯỚC 2 -->
        <div class="timeline-step" style="--step-color: #0ea5e9;"> <!-- Info Cyan -->
            <div class="timeline-icon"><i class="bi bi-search"></i></div>
            <div class="timeline-card">
                <h3 class="fw-bold mb-3" style="color: #0ea5e9;">Bước 2: Khảo Sát & Báo Giá Tận Nơi</h3>
                <p class="text-muted fw-medium mb-3">Sau khi có mặt tại nhà, kỹ thuật viên tiến hành quy trình kiểm tra chuyên sâu:</p>
                <ul class="step-list">
                    <li><i class="bi bi-check-circle-fill"></i> Kiểm tra toàn diện dàn nóng, dàn lạnh, gas và board mạch.</li>
                    <li><i class="bi bi-check-circle-fill"></i> Xác định chính xác nguyên nhân gây lỗi và đưa ra phương án xử lý tối ưu, tiết kiệm nhất.</li>
                    <li><i class="bi bi-check-circle-fill"></i> <span><strong>Cam kết:</strong> Trình bày rõ ràng chi phí sửa chữa/thay thế linh kiện theo đúng bảng giá niêm yết của BPV Store. <strong class="text-danger bg-danger bg-opacity-10 px-2 py-1 rounded">Khách hàng đồng ý mới tiến hành làm.</strong></span></li>
                </ul>
            </div>
        </div>

        <!-- BƯỚC 3 -->
        <div class="timeline-step" style="--step-color: #f59e0b;"> <!-- Warning Amber -->
            <div class="timeline-icon"><i class="bi bi-tools"></i></div>
            <div class="timeline-card">
                <h3 class="fw-bold mb-3" style="color: #f59e0b;">Bước 3: Tiến Hành Sửa Chữa & Lắp Đặt</h3>
                <p class="text-muted fw-medium mb-3">Với sự đồng ý về phương án và chi phí, thợ bắt đầu công việc:</p>
                <ul class="step-list">
                    <li><i class="bi bi-check-circle-fill"></i> Thực hiện sửa chữa, bơm gas hoặc tháo lắp đúng tiêu chuẩn kỹ thuật an toàn.</li>
                    <li><i class="bi bi-check-circle-fill"></i> Sử dụng 100% linh kiện chính hãng, có xuất xứ rõ ràng.</li>
                    <li><i class="bi bi-check-circle-fill"></i> Đảm bảo giữ gìn vệ sinh không gian nhà cửa của khách hàng trong suốt quá trình làm việc.</li>
                </ul>
            </div>
        </div>

        <!-- BƯỚC 4 -->
        <div class="timeline-step" style="--step-color: #10b981;"> <!-- Success Emerald -->
            <div class="timeline-icon"><i class="bi bi-shield-check"></i></div>
            <div class="timeline-card">
                <h3 class="fw-bold mb-3" style="color: #10b981;">Bước 4: Nghiệm Thu, Thanh Toán & Bảo Hành</h3>
                <p class="text-muted fw-medium mb-3">Hoàn tất công việc, kỹ thuật viên thực hiện các bước cuối cùng:</p>
                <ul class="step-list">
                    <li><i class="bi bi-check-circle-fill"></i> Khởi động máy lạnh, cùng khách hàng kiểm tra độ lạnh và sự vận hành êm ái của máy.</li>
                    <li><i class="bi bi-check-circle-fill"></i> Bàn giao máy, hướng dẫn khách hàng cách sử dụng máy lạnh tiết kiệm điện và bền bỉ.</li>
                    <li><i class="bi bi-check-circle-fill"></i> Viết phiếu bảo hành điện tử, dán tem bảo hành và tiến hành thu phí dịch vụ.</li>
                </ul>
            </div>
        </div>

    </div>

    <!-- KHỐI KÊU GỌI HÀNH ĐỘNG (CTA) NÂNG CẤP -->
    <div class="cta-super-block">
        <div class="position-relative z-2">
            <h2 class="fw-black mb-3 display-6" style="font-weight: 900;">Sẵn Sàng Trải Nghiệm Dịch Vụ Của Chúng Tôi?</h2>
            <p class="mb-5 text-light fw-medium fs-5 opacity-75 mx-auto" style="max-width: 600px;">Hãy để BPV Store mang không khí mát mẻ trở lại căn phòng của bạn ngay hôm nay.</p>
            
            <a asp-controller="Home" asp-action="Booking" class="btn btn-light btn-cta rounded-pill fw-bold text-primary shadow-lg d-inline-flex align-items-center">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px;">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
                Trải Nghiệm Dịch Vụ Ngay
            </a>
        </div>
    </div>
</div>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        :root {
            --primary: #4338ca; --secondary: #3b82f6; --success: #10b981; 
            --warning: #f59e0b; --danger: #ef4444; --dark: #0f172a; --surface: rgba(255, 255, 255, 0.9);
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; color: #334155;
            background-image: radial-gradient(at 0% 0%, rgba(67, 56, 202, 0.05) 0, transparent 50%), radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.05) 0, transparent 50%);
            background-attachment: fixed; min-height: 100vh;
            padding-top: 80px; 
        }

        .glass-card {
            background: var(--surface); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 1);
            border-radius: 20px; box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease; overflow: hidden;
        }
        .glass-card:hover { transform: translateY(-3px); box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.08); }

        .admin-navbar {
            background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.6); box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
            position: fixed; top: 0; left: 0; right: 0; z-index: 1030;
        }
        .nav-link { font-weight: 700; color: #64748b; padding: 0.5rem 1rem; border-radius: 12px; transition: 0.3s; margin: 0 5px; }
        .nav-link:hover, .nav-link.active { background: #eff6ff; color: var(--primary); }

        .kpi-icon { width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: white; }
        .bg-grad-primary { background: linear-gradient(135deg, #6366f1, #4338ca); box-shadow: 0 8px 20px -5px rgba(99, 102, 241, 0.5); }
        .bg-grad-success { background: linear-gradient(135deg, #34d399, #059669); box-shadow: 0 8px 20px -5px rgba(16, 185, 129, 0.5); }
        .bg-grad-warning { background: linear-gradient(135deg, #fbbf24, #d97706); box-shadow: 0 8px 20px -5px rgba(245, 158, 11, 0.5); }
        .bg-grad-info { background: linear-gradient(135deg, #38bdf8, #0284c7); box-shadow: 0 8px 20px -5px rgba(14, 165, 233, 0.5); }
        
        .modern-table th { border: none; background: #f8fafc; color: #64748b; font-weight: 700; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; padding: 1rem; }
        .modern-table td { border-bottom: 1px solid #f1f5f9; padding: 1.25rem 1rem; vertical-align: middle; font-weight: 500; }
        .badge-soft { padding: 6px 12px; border-radius: 8px; font-weight: 700; font-size: 0.75rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg admin-navbar py-2">
        <div class="container-fluid px-lg-5">
            <a class="navbar-brand fw-black text-primary d-flex align-items-center" href="/Admin/Index">
                <i class="bi bi-rocket-takeoff-fill me-2 fs-3"></i> BPV ADMIN
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu">
                <i class="bi bi-list fs-2 text-dark"></i>
            </button>
            <div class="collapse navbar-collapse" id="adminMenu">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-2">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-pie-chart-fill me-1"></i> Bảng Thống Kê
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "ManageOrders" ? "active" : "")" asp-controller="Admin" asp-action="ManageOrders">
                            <i class="bi bi-receipt-cutoff me-1"></i> Quản Lý Đơn Hàng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "ManageTechs" ? "active" : "")" asp-controller="Admin" asp-action="ManageTechs">
                            <i class="bi bi-people-fill me-1"></i> Quản Lý Thợ
                        </a>
                    </li>
                    
                    <!-- CHỨC NĂNG MỚI: DUYỆT HỒ SƠ ỨNG TUYỂN -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "ManageApplications" ? "active" : "")" asp-controller="Admin" asp-action="ManageApplications">
                            <i class="bi bi-person-lines-fill me-1"></i> Duyệt Hồ Sơ
                            <!-- Gọi hàm tĩnh từ Controller để đếm số đơn chờ duyệt -->
                            @{
                                int pendingCount = Webdienlanh.Controllers.AdminController.PendingApplications.Count(a => a.Status == "Chờ duyệt");
                                if (pendingCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-1 pulse-animation">Mới</span>
                                }
                            }
                        </a>
                    </li>
                </ul>
                <div class="d-flex">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
                        Đăng Xuất <i class="bi bi-box-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    @RenderSection("Scripts", required: false)

    <style>
        .pulse-animation {
            animation: pulse 2s infinite;
        }
        @@keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
    </style>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bpv store</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- CSS tùy chỉnh hiệu ứng đổi màu khi rê chuột vào biểu tượng -->
    <style>
        .bi {
            transition: color 0.2s ease-in-out, transform 0.2s ease-in-out;
        }

        .bi:hover {
            color: #0d6efd !important;
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid position-relative d-flex align-items-center">

                <button class="navbar-toggler border-0 ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <a class="navbar-brand fw-bold fs-4 text-uppercase m-0 position-absolute start-50 translate-middle-x" style="letter-spacing: 1px;" asp-area="" asp-controller="Home" asp-action="Index">
                    bpv store
                </a>

                <!-- Khu vực Icon bên phải -->
                <div class="d-flex align-items-center ms-auto me-2">
                    <!-- Tích hợp link Tra Cứu Tiến Độ VIP vào Icon Kính Lúp -->
                    <a asp-controller="Home" asp-action="TrackOrder" class="text-dark me-3" title="Tra cứu tiến độ đơn hàng">
                        <i class="bi bi-search fs-5"></i>
                    </a>

                    <a asp-controller="Account" asp-action="Login" class="text-dark" title="Đăng nhập hệ thống">
                        <i class="bi bi-person fs-5"></i>
                    </a>
                </div>

            </div>

            <!-- Menu xổ xuống -->
            <div class="collapse navbar-collapse bg-white w-100 px-3 mt-2" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 border-top pt-2">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Booking">Đặt lịch dịch vụ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="TrackOrder">Tra cứu đơn hàng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Workflow">Quy trình</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-uppercase fw-bold mb-3 text-white" style="letter-spacing: 1px;">bpv store</h5>
                    <p class="text-secondary">
                        Hệ thống cung cấp dịch vụ lắp đặt, bảo trì và sửa chữa máy lạnh chuyên nghiệp. Nhanh chóng - Uy tín - Chất lượng.
                    </p>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-uppercase fw-bold mb-3 text-white">Thông tin liên hệ</h5>
                    <ul class="list-unstyled text-secondary">
                        <li class="mb-2">
                            <i class="bi bi-geo-alt-fill me-2 text-primary"></i> Địa chỉ: Đại Học Thủ Dầu Một
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-telephone-fill me-2 text-primary"></i> Hotline: 0866450439
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope-fill me-2 text-primary"></i> Email: support@bpvstore.vn
                        </li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 mb-4">
                    <h5 class="text-uppercase fw-bold mb-3 text-white">Kết nối với chúng tôi</h5>
                    <p class="text-secondary">Theo dõi Fanpage và TikTok để cập nhật các khuyến mãi mới nhất.</p>
                    <div class="mt-3 d-flex gap-3">
                        <a href="https://www.facebook.com/share/199vs4CSum/?mibextid=wwXIfr" target="_blank" class="text-light d-flex align-items-center justify-content-center rounded-circle border border-light text-decoration-none" style="width: 45px; height: 45px;" title="Facebook">
                            <i class="bi bi-facebook fs-4"></i>
                        </a>
                        <a href="https://www.tiktok.com/@@nguyenpcgm?_r=1&_t=ZS-993xPtwPH0C" target="_blank" class="text-light d-flex align-items-center justify-content-center rounded-circle border border-light text-decoration-none" style="width: 45px; height: 45px;" title="TikTok">
                            <i class="bi bi-tiktok fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>

            <hr class="mb-4 border-secondary" />

            <div class="row align-items-center">
                <div class="col-md-7 col-lg-8">
                    <p class="text-secondary mb-0">
                        &copy; 2026 - BPV Store. All rights reserved.
                    </p>
                </div>
                <div class="col-md-5 col-lg-4 text-md-end">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none text-light hover-white">
                        Chính sách bảo mật
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Thư viện SweetAlert2 tích hợp toàn hệ thống -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Đã fix lỗi font tiếng Việt bằng Json.Serialize
        var successMsg = @Json.Serialize(TempData["SuccessMessage"]);
        if (successMsg) {
            Swal.fire({
                title: 'Thành công!',
                text: successMsg,
                icon: 'success',
                confirmButtonColor: '#198754',
                confirmButtonText: 'Tuyệt vời',
                timer: 3000,
                timerProgressBar: true
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
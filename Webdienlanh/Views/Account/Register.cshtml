@model Webdienlanh.Models.Technician
@{
    ViewData["Title"] = "Nộp Hồ Sơ Ứng Tuyển Kỹ Thuật Viên - BPV STORE";
}

<!-- FONT CHUẨN QUỐC TẾ -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --primary: #2563eb;
        --primary-glow: rgba(37, 99, 235, 0.15);
        --dark: #0f172a;
        --surface: #ffffff;
        --bg-light: #f8fafc;
    }

    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--bg-light); }

    /* ================= 1. LEFT BANNER ================= */
    .pitch-box {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-radius: 24px; padding: 3rem 2.5rem; color: white;
        position: relative; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(37, 99, 235, 0.3);
    }
    .pitch-box::after {
        content: ''; position: absolute; bottom: -20%; right: -20%; width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%); border-radius: 50%;
    }
    .pitch-icon-box {
        width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0;
        background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px);
        display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.3);
    }

    /* ================= 2. FORM & INPUTS ================= */
    .form-wrapper {
        background: var(--surface); border-radius: 24px; padding: 2.5rem 3rem;
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.04); border: 1px solid #e2e8f0;
    }
    .step-header { display: flex; align-items: center; gap: 12px; margin-bottom: 1.25rem; }
    .step-num {
        width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1rem; background: var(--dark); color: white; box-shadow: 0 4px 10px rgba(15,23,42,0.2);
    }
    .section-box { background: var(--bg-light); border-radius: 20px; padding: 2rem; border: 1px solid #f1f5f9; }

    .form-floating > .form-control, .form-floating > .form-select {
        border-radius: 16px; border: 2px solid #e2e8f0; font-weight: 600; color: var(--dark);
        transition: all 0.2s ease; background-color: white; height: calc(3.8rem + 2px);
    }
    .form-floating > .form-control:focus, .form-floating > .form-select:focus {
        border-color: var(--primary); box-shadow: 0 0 0 4px var(--primary-glow); background-color: white;
    }
    .form-floating > label { font-weight: 600; color: #64748b; font-size: 0.95rem; }

    /* ================= 3. SKILL PILLS ================= */
    .skill-checkbox:checked + label {
        background-color: var(--primary); color: white !important;
        box-shadow: 0 5px 15px var(--primary-glow); border-color: var(--primary); transform: translateY(-2px);
    }
    .skill-checkbox + label { 
        transition: all 0.2s ease; border-width: 2px; color: var(--dark); border-color: #e2e8f0; 
        padding: 8px 20px; font-weight: 700; font-size: 0.9rem; background: white;
    }
    .skill-checkbox + label:hover { border-color: #cbd5e1; background: #f8fafc; }

    /* ================= 4. UPLOAD ZONE ================= */
    .custom-file-upload {
        border: 2px dashed #cbd5e1; border-radius: 16px; padding: 2rem; text-align: center;
        background: white; cursor: pointer; transition: all 0.3s ease;
    }
    .custom-file-upload:hover, .custom-file-upload.dragover { border-color: var(--primary); background: #eff6ff; }

    /* ================= 5. T&C SCROLL BOX (ĐIỀU KHOẢN) ================= */
    .terms-box {
        background: white; border: 2px solid #e2e8f0; border-radius: 16px; 
        padding: 1.5rem; max-height: 220px; overflow-y: auto; margin-bottom: 1rem;
        font-size: 0.85rem; color: #475569; line-height: 1.6;
    }
    .terms-box::-webkit-scrollbar { width: 6px; }
    .terms-box::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    
    .btn-submit-hero {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border: none;
        color: white; border-radius: 16px; transition: all 0.3s ease; padding: 16px;
    }
    .btn-submit-hero:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3); }
</style>

<div class="container py-5 mt-2">
    <div class="row g-4 g-lg-5 justify-content-center align-items-stretch">

        <!-- CỘT TRÁI: BANNER TUYỂN DỤNG -->
        <div class="col-xl-4 col-lg-5 d-none d-lg-block">
            <div class="pitch-box h-100 position-sticky" style="top: 2rem;">
                <span class="badge bg-white text-primary mb-4 px-3 py-2 rounded-pill fw-black shadow-sm" style="letter-spacing: 1px;">TUYỂN DỤNG ĐỐI TÁC</span>
                <h2 class="fw-black mb-4 display-6" style="font-weight: 900; line-height: 1.2; letter-spacing: -1px;">Gia nhập mạng lưới Kỹ Thuật Viên BPV</h2>
                <p class="fs-6 opacity-75 mb-5 fw-medium">Hệ sinh thái kết nối thợ điện lạnh số 1. Gia tăng thu nhập thụ động với nguồn khách hàng dồi dào, ổn định mỗi ngày.</p>

                <div class="d-flex align-items-start mb-4">
                    <div class="pitch-icon-box me-3"><i class="bi bi-wallet2 fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Thu nhập không giới hạn</h6>
                        <p class="small opacity-75 mb-0">Chiết khấu minh bạch, nhận tiền chuyển khoản ngay trong ngày.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-4">
                    <div class="pitch-icon-box me-3"><i class="bi bi-clock-history fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Tự do làm chủ thời gian</h6>
                        <p class="small opacity-75 mb-0">Bật/tắt ứng dụng để nhận việc bất cứ khi nào rảnh rỗi.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start">
                    <div class="pitch-icon-box me-3"><i class="bi bi-shield-check fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Bảo vệ quyền lợi Đối tác</h6>
                        <p class="small opacity-75 mb-0">Đội ngũ điều phối hỗ trợ 24/7, đền bù nếu khách hàng bùng đơn.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM ỨNG TUYỂN -->
        <div class="col-xl-8 col-lg-7">
            <div class="form-wrapper relative">

                <!-- Header Form -->
                <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
                    <div>
                        <h3 class="fw-black text-dark mb-1" style="letter-spacing: -0.5px;">Hồ Sơ Ứng Tuyển (CV)</h3>
                        <p class="text-muted small fw-medium mb-0">Hệ thống xét duyệt tự động trong vòng 24 giờ.</p>
                    </div>
                    <div class="text-end d-none d-sm-block">
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger p-3 small mb-4 rounded-3 border-0 bg-danger bg-opacity-10 text-danger fw-bold d-flex align-items-center">
                        <i class="bi bi-exclamation-octagon-fill fs-5 me-2"></i> @TempData["ErrorMessage"]
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success p-3 small mb-4 rounded-3 border-0 bg-success bg-opacity-10 text-success fw-bold d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-5 me-2"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <!-- TRỎ THẲNG ACTION VỀ ADMIN ĐỂ NHẬN DỮ LIỆU THẬT -->
                <form asp-controller="Admin" asp-action="SubmitApplication" method="post" enctype="multipart/form-data" id="registerForm">

                    <!-- BƯỚC 1: LÝ LỊCH CÁ NHÂN -->
                    <div class="step-header mt-2">
                        <span class="step-num">1</span>
                        <h5 class="fw-bold text-dark mb-0">Lý Lịch & Khu Vực Hoạt Động</h5>
                    </div>
                    <div class="section-box mb-5">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control" name="fullName" placeholder="Họ và tên" required />
                                    <label><i class="bi bi-person-vcard me-1"></i> Họ tên (Đúng trên CCCD)</label>
                                    <span asp-validation-for="FullName" class="text-danger small px-2 fw-bold"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Phone" type="tel" class="form-control" name="phone" placeholder="SĐT" required pattern="[0-9]{10,11}" />
                                    <label><i class="bi bi-telephone me-1"></i> SĐT liên hệ (Có Zalo)</label>
                                    <span asp-validation-for="Phone" class="text-danger small px-2 fw-bold"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select" name="area" required>
                                        <option value="" disabled selected>Chọn khu vực ưu tiên</option>
                                        <option value="Thủ Dầu Một">TP. Thủ Dầu Một</option>
                                        <option value="Dĩ An">TP. Dĩ An</option>
                                        <option value="Thuận An">TP. Thuận An</option>
                                        <option value="Bến Cát">TX. Bến Cát</option>
                                        <option value="Tân Uyên">TP. Tân Uyên</option>
                                    </select>
                                    <label><i class="bi bi-geo-alt me-1"></i> Khu vực muốn nhận đơn</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select" name="experience" required>
                                        <option value="" disabled selected>Kinh nghiệm thực tế</option>
                                        <option value="Dưới 1 năm">Thợ phụ (Dưới 1 năm)</option>
                                        <option value="1-3 năm">Thợ chính (1 - 3 năm)</option>
                                        <option value="Trên 3 năm">Thợ cứng / Kỹ sư (Trên 3 năm)</option>
                                    </select>
                                    <label><i class="bi bi-briefcase me-1"></i> Cấp bậc thợ</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BƯỚC 2: CHUYÊN MÔN & GIẤY TỜ -->
                    <div class="step-header">
                        <span class="step-num bg-primary">2</span>
                        <h5 class="fw-bold text-dark mb-0">Xác Thực Năng Lực</h5>
                    </div>
                    <div class="section-box mb-5">
                        
                        <label class="fw-bold small text-dark mb-3 d-block"><i class="bi bi-tools text-primary me-1"></i> Dịch vụ có thể đảm nhận (Chọn nhiều):</label>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <input type="checkbox" class="btn-check skill-checkbox" name="services" value="Vệ sinh máy lạnh" id="sk1" autocomplete="off">
                            <label class="btn btn-outline-secondary rounded-pill" for="sk1">Vệ sinh máy lạnh</label>

                            <input type="checkbox" class="btn-check skill-checkbox" name="services" value="Bơm Gas" id="sk2" autocomplete="off">
                            <label class="btn btn-outline-secondary rounded-pill" for="sk2">Bơm Gas</label>

                            <input type="checkbox" class="btn-check skill-checkbox" name="services" value="Lắp đặt, di dời" id="sk3" autocomplete="off">
                            <label class="btn btn-outline-secondary rounded-pill" for="sk3">Lắp đặt, di dời</label>

                            <input type="checkbox" class="btn-check skill-checkbox" name="services" value="Sửa bo mạch" id="sk4" autocomplete="off">
                            <label class="btn btn-outline-secondary rounded-pill" for="sk4">Sửa bo mạch (Nâng cao)</label>
                            
                            <input type="checkbox" class="btn-check skill-checkbox" name="services" value="Máy giặt / Tủ lạnh" id="sk5" autocomplete="off">
                            <label class="btn btn-outline-secondary rounded-pill" for="sk5">Máy giặt / Tủ lạnh</label>
                        </div>

                        <label class="fw-bold small text-dark mb-3 d-block mt-2"><i class="bi bi-person-bounding-box text-primary me-1"></i> Tải lên CCCD & Chứng chỉ (Bắt buộc để duyệt):</label>
                        <div class="custom-file-upload" id="drop-zone" onclick="document.getElementById('fileUpload').click();">
                            <i class="bi bi-cloud-arrow-up fs-1 text-primary opacity-75 mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark mb-1" id="file-name-display">Kéo thả file hoặc nhấp để chọn</h6>
                            <p class="text-muted small mb-0">Hỗ trợ: JPG, PNG, PDF (Mặt trước + Mặt sau CCCD)</p>
                            <input type="file" name="IdentityFiles" class="d-none" id="fileUpload" multiple accept=".jpg,.png,.pdf">
                        </div>
                    </div>

                    <!-- BƯỚC 3: TÀI KHOẢN & ĐIỀU KHOẢN (REALISTIC APP) -->
                    <div class="step-header">
                        <span class="step-num bg-success">3</span>
                        <h5 class="fw-bold text-dark mb-0">Tài Khoản & Khế Ước Đối Tác</h5>
                    </div>
                    <div class="section-box mb-4">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Username" class="form-control" placeholder="Tên đăng nhập" required />
                                    <label><i class="bi bi-person-badge me-1"></i> ID Đăng nhập (Username)</label>
                                    <span asp-validation-for="Username" class="text-danger small px-2 fw-bold"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" required />
                                    <label><i class="bi bi-shield-lock me-1"></i> Mật khẩu truy cập</label>
                                    <span asp-validation-for="Password" class="text-danger small px-2 fw-bold"></span>
                                </div>
                            </div>
                        </div>

                        <!-- KHUNG ĐIỀU KHOẢN CHUYÊN NGHIỆP THỰC TẾ -->
                        <label class="fw-bold small text-dark mb-2 d-block"><i class="bi bi-file-earmark-text text-primary me-1"></i> Điều khoản hợp tác BPV Store:</label>
                        <div class="terms-box">
                            <p class="mb-2"><strong>Điều 1. Tiêu chuẩn Kỹ Thuật Viên:</strong> Đối tác cam kết đủ 18 tuổi trở lên, có đầy đủ năng lực hành vi dân sự. Đảm bảo lý lịch tư pháp trong sạch, không có tiền án tiền sự. Trang bị đầy đủ công cụ, đồ nghề tiêu chuẩn (thang, máy bơm áp lực, đồng hồ gas...) trước khi nhận việc.</p>
                            
                            <p class="mb-2"><strong>Điều 2. Tác phong & Phục vụ:</strong> Bắt buộc mặc đồng phục BPV (nếu có) hoặc trang phục lịch sự khi đến nhà khách hàng. Tuyệt đối không thu thêm phụ phí ngoài báo giá hệ thống mà không có sự đồng ý của khách hàng và BQL.</p>
                            
                            <p class="mb-2"><strong>Điều 3. Chính sách Chiết khấu & Thanh toán:</strong> BPV Store thu phí nền tảng <b>15% - 20%</b> trên tổng giá trị nhân công của mỗi đơn hàng hoàn thành (Không thu chiết khấu trên tiền vật tư). Tiền sẽ được đối soát và thanh toán qua thẻ ngân hàng vào thứ 3 và thứ 6 hàng tuần.</p>
                            
                            <p class="mb-0"><strong>Điều 4. Vi phạm & Chế tài:</strong> Tài khoản sẽ bị khóa vĩnh viễn nếu phát hiện hành vi: Trộm cắp vật tư, vòi vĩnh tiền tip, lén lút nhận khách riêng vượt mặt nền tảng, hoặc bị khách hàng đánh giá 1 sao quá 3 lần/tháng.</p>
                        </div>

                        <div class="form-check d-flex align-items-center mt-3">
                            <input class="form-check-input mt-0 me-2" type="checkbox" id="termsCheck" required style="width: 22px; height: 22px; border-width: 2px;">
                            <label class="form-check-label fw-bold text-dark small cursor-pointer" for="termsCheck">
                                Tôi đã đọc kỹ, hiểu rõ và chấp thuận mọi điều khoản Hợp đồng dịch vụ.
                            </label>
                        </div>
                    </div>

                    <!-- Nút Submit -->
                    <div class="row g-3 mt-4">
                        <div class="col-md-8">
                            <button type="submit" class="btn btn-submit-hero w-100 fw-bold fs-5 text-uppercase shadow" style="letter-spacing: 1px;">
                                <i class="bi bi-rocket-takeoff-fill me-2"></i> Gửi Hồ Sơ Xét Duyệt
                            </button>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-light border-2 w-100 py-3 rounded-4 fw-bold text-dark d-flex align-items-center justify-content-center" style="height: 100%;">
                                Đã có tài khoản?
                            </a>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<!-- ================= JAVASCRIPT: LOGIC TƯƠNG TÁC ================= -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('fileUpload');
        const fileNameDisplay = document.getElementById('file-name-display');
        const form = document.getElementById('registerForm');

        // Logic Kéo thả File cực mượt
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) { e.preventDefault(); e.stopPropagation(); }

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.add('dragover'), false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.remove('dragover'), false);
        });

        dropZone.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            fileInput.files = files;
            updateFileName(files);
        });

        fileInput.addEventListener('change', function() {
            updateFileName(this.files);
        });

        function updateFileName(files) {
            if (files && files.length > 0) {
                if(files.length === 1) {
                    fileNameDisplay.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Đã tải lên: ${files[0].name}</span>`;
                } else {
                    fileNameDisplay.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Đã tải lên ${files.length} mặt giấy tờ</span>`;
                }
                dropZone.style.borderColor = "#10b981"; // Đổi viền sang xanh lá
                dropZone.style.backgroundColor = "#ecfdf5";
            } else {
                fileNameDisplay.innerHTML = `Kéo thả file hoặc nhấp để chọn`;
                dropZone.style.borderColor = "#cbd5e1";
                dropZone.style.backgroundColor = "white";
            }
        }

        // Logic Validation khi Submit Form
        form.addEventListener('submit', function(e) {
            // Kiểm tra chọn ít nhất 1 kỹ năng
            const checkedSkills = document.querySelectorAll('.skill-checkbox:checked').length;
            if (checkedSkills === 0) {
                e.preventDefault();
                alert('Vui lòng chọn ít nhất 1 "Dịch vụ có thể đảm nhận" để xét duyệt!');
                document.getElementById('sk1').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            // (Tuỳ chọn) Bắt buộc upload giấy tờ
            if(fileInput.files.length === 0) {
                const confirmNoDoc = confirm("Bạn chưa tải lên CCCD. Hồ sơ không có giấy tờ có thể mất thời gian duyệt lâu hơn. Bạn vẫn muốn gửi?");
                if(!confirmNoDoc) e.preventDefault();
            }
        });
    });
</script>
<!-- ================= JAVASCRIPT GỐC + CAMERA BÁO CÁO + NẠP TIỀN & ĐƠN HÀNG QR ================= -->
<script>
    // Hàm định dạng số tiền VND
    function formatCurrency(num) {
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    // ----------------------------------------------------
    // HÀM MỞ MODAL NHẬN CHUYỂN KHOẢN KÈM QR ĐỘNG (GIAO DIỆN 2 CỘT MỚI)
    // ----------------------------------------------------
    function openSharedQrModal(orderId, amount) {
        // Gán ID đơn hàng và số tiền vào form ẩn để Submit
        document.getElementById('modalOrderId').value = orderId;
        document.getElementById('modalOrderTotal').value = amount;
        
        // Tạo thông số gọi API VietQR
        const BANK_ID = "MB"; // Thay đổi ngân hàng nếu cần
        const ACCOUNT_NO = "999988887777"; // Thay đổi STK nhận tiền nếu cần
        const transferMsg = `THANH TOAN DON ${orderId}`; // Nội dung CK chứa mã đơn
        
        // Gọi API sinh ảnh QR
        const qrUrl = `https://img.vietqr.io/image/${BANK_ID}-${ACCOUNT_NO}-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(transferMsg)}&accountName=BPV%20STORE`;
        
        // Đẩy vào giao diện Modal hiển thị cho khách quét
        document.getElementById('qrImageOrder').src = qrUrl;
        document.getElementById('qrDisplayAmountOrder').textContent = formatCurrency(amount) + "đ";
        document.getElementById('orderTransferContent').textContent = transferMsg;

        // Reset lại ảnh cũ nếu có
        document.getElementById('fileUpload_qr').value = ""; 
        document.getElementById('previewImg_qr').src = "";
        document.getElementById('previewImg_qr').style.display = 'none';
        document.getElementById('uploadContent_qr').style.display = 'flex'; 
        document.getElementById('btnRemove_qr').style.display = 'none';

        new bootstrap.Modal(document.getElementById('sharedQrModal')).show();
    }

    // ----------------------------------------------------
    // CÁC HÀM CŨ (ĐÃ ĐƯỢC GIỮ NGUYÊN)
    // ----------------------------------------------------
    let activeOrderId = 0;
    let chatInterval = null;

    function goToMap(orderId, address) {
        window.open('https://www.google.com/maps/search/?api=1&query=' + address, '_blank');
        let formData = new FormData();
        formData.append('id', orderId);
        formData.append('status', 2);
        fetch('/Technician/UpdateStatus', { method: 'POST', body: formData }).then(() => { setTimeout(() => location.reload(), 800); });
    }

    function openInputCostModal(orderId) {
        document.getElementById('costModalOrderId').value = orderId;
        document.querySelector('#sharedInputCostModal input[name="orderTotal"]').value = "";
        
        document.getElementById('fileUpload_cost').value = ""; 
        document.getElementById('previewImg_cost').style.display = 'none';
        document.getElementById('uploadContent_cost').style.display = 'flex'; 
        document.getElementById('btnRemove_cost').style.display = 'none';

        new bootstrap.Modal(document.getElementById('sharedInputCostModal')).show();
    }

    function openChatModal(orderId, role) {
        activeOrderId = orderId;
        document.getElementById('chatOrderId').value = orderId;
        document.getElementById('chatSenderRole').value = role;
        if (chatInterval) clearInterval(chatInterval);
        loadMessages();
        new bootstrap.Modal(document.getElementById('chatModal')).show();
        chatInterval = setInterval(() => { if (activeOrderId === orderId) loadMessages(); }, 2000);
    }

    function closeChatModal() { if (chatInterval) clearInterval(chatInterval); activeOrderId = 0; }

    function loadMessages() {
        if (!activeOrderId) return;
        fetch('/Chat/GetMessages?orderId=' + activeOrderId).then(res => res.json()).then(data => {
            let box = document.getElementById('chatBox');
            let currentRole = document.getElementById('chatSenderRole').value;
            box.innerHTML = '';
            if (!data || data.length === 0) {
                box.innerHTML = '<div class="text-center mt-5"><i class="bi bi-chat-heart text-black-50" style="font-size: 3rem;"></i><p class="text-muted fw-bold mt-2">Bắt đầu cuộc trò chuyện!</p></div>';
                return;
            }
            data.forEach(m => {
                let isMe = m.senderRole === currentRole;
                let wrap = isMe ? 'justify-content-end' : 'justify-content-start';
                let bg = isMe ? 'bg-primary text-white' : 'bg-white text-dark border shadow-sm';
                let timeAlign = isMe ? 'text-end' : 'text-start';
                box.innerHTML += `
                    <div class="d-flex w-100 ${wrap} mb-3">
                        <div style="max-width: 75%;">
                            <div class="p-3 rounded-4 ${bg}" style="${isMe ? 'border-bottom-right-radius: 4px !important;' : 'border-bottom-left-radius: 4px !important;'}">
                                ${m.messageText}
                            </div>
                            <div class="small text-muted mt-1 ${timeAlign}" style="font-size: 0.7rem; font-weight: 600;">${m.sentAt}</div>
                        </div>
                    </div>`;
            });
            box.scrollTop = box.scrollHeight;
        });
    }

    function sendChatMessage(e) {
        e.preventDefault();
        let input = document.getElementById('chatInputText');
        if (!input.value.trim()) return;
        let formData = new FormData();
        formData.append('orderId', activeOrderId);
        formData.append('senderRole', document.getElementById('chatSenderRole').value);
        formData.append('messageText', input.value.trim());
        fetch('/Chat/SendMessage', { method: 'POST', body: formData }).then(res => res.json()).then(res => {
            if (res.success) { input.value = ''; loadMessages(); }
        });
    }

    function filterTable() {
        var input = document.getElementById("searchInput").value.toUpperCase();
        document.querySelectorAll(".searchable-item").forEach((item) => {
            item.style.display = item.innerText.toUpperCase().includes(input) ? "" : "none";
        });
    }

    // ----------------------------------------------------
    // JAVASCRIPT XỬ LÝ CAMERA BÁO CÁO
    // ----------------------------------------------------
    function handlePhotoUpload(input, type) {
        const previewImg = document.getElementById(`previewImg_${type}`);
        const uploadContent = document.getElementById(`uploadContent_${type}`);
        const btnRemove = document.getElementById(`btnRemove_${type}`);

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                previewImg.style.display = 'block';
                uploadContent.style.display = 'none';
                btnRemove.style.display = 'flex';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function removePhoto(event, type) {
        event.stopPropagation(); // Ngăn click nhầm mở lại input file
        const input = document.getElementById(`fileUpload_${type}`);
        const previewImg = document.getElementById(`previewImg_${type}`);
        const uploadContent = document.getElementById(`uploadContent_${type}`);
        const btnRemove = document.getElementById(`btnRemove_${type}`);

        input.value = ""; 
        previewImg.src = "";
        previewImg.style.display = 'none';
        uploadContent.style.display = 'flex';
        btnRemove.style.display = 'none';
    }

    // ----------------------------------------------------
    // AJAX SUBMIT (BAO GỒM CẢ FILE UPLOAD - FORM DATA)
    // ----------------------------------------------------
    document.addEventListener("submit", async function(e) {
        if (e.target.closest('form') && (e.target.closest('.tab-content') || e.target.closest('.modal')) && e.target.id !== 'chatForm') {
            e.preventDefault();
            let form = e.target;
            let btn = form.querySelector('button[type="submit"]');
            if(btn) { btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>...'; btn.classList.add('disabled'); }
            try {
                let response = await fetch(form.action, { method: form.method, body: new FormData(form) });
                let newDoc = new DOMParser().parseFromString(await response.text(), 'text/html');
                
                document.querySelectorAll('.modal').forEach(m => { 
                    let i = bootstrap.Modal.getInstance(m); 
                    if (i && m.id !== 'chatModal') i.hide(); 
                });
                
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.body.classList.remove('modal-open'); document.body.style = '';
                
                ['.wallet-card h2', '#pills-tab', '#pills-tabContent', '#alert-container'].forEach(s => {
                    let oldEl = document.querySelector(s), newEl = newDoc.querySelector(s);
                    if(oldEl && newEl) oldEl.innerHTML = newEl.innerHTML;
                });
            } catch (error) { location.reload(); }
        }
    });

    // ----------------------------------------------------
    // LOGIC TẠO MÃ QR NẠP TIỀN VÀO VÍ TỰ ĐỘNG
    // ----------------------------------------------------
    document.addEventListener("DOMContentLoaded", function() {
        const inputAmount = document.getElementById('depositAmount');
        const chipBtns = document.querySelectorAll('.chip-btn');
        const btnGenerateQR = document.getElementById('btnGenerateQR');
        const btnBackToInput = document.getElementById('btnBackToInput');
        
        const inputSection = document.getElementById('input-section');
        const qrSection = document.getElementById('qr-section');
        
        const qrImage = document.getElementById('qrImage');
        const qrDisplayAmount = document.getElementById('qrDisplayAmount');
        const transferContentEl = document.getElementById('transferContent');

        const BANK_ID = "MB"; // Mã ngân hàng
        const ACCOUNT_NO = "999988887777"; // Số tài khoản admin

        if(inputAmount) {
            inputAmount.addEventListener('input', function(e) {
                let value = this.value.replace(/[^0-9]/g, '');
                if (value === "") { this.value = ""; return; }
                this.value = formatCurrency(value);
                chipBtns.forEach(btn => btn.classList.remove('active'));
            });
        }

        chipBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                chipBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                let val = this.getAttribute('data-val');
                inputAmount.value = formatCurrency(val);
            });
        });

        if(btnGenerateQR) {
            btnGenerateQR.addEventListener('click', function() {
                let rawValue = inputAmount.value.replace(/,/g, '');
                let amount = parseInt(rawValue);

                if (isNaN(amount) || amount < 50000) {
                    alert("Vui lòng nạp tối thiểu 50,000đ để kích hoạt tài khoản!");
                    return;
                }

                let transferMsg = `NAP BPV THO123`;
                transferContentEl.textContent = transferMsg;
                
                let qrUrl = `https://img.vietqr.io/image/${BANK_ID}-${ACCOUNT_NO}-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(transferMsg)}&accountName=BPV%20STORE`;
                
                qrImage.src = qrUrl;
                qrDisplayAmount.textContent = formatCurrency(amount) + "đ";

                inputSection.style.display = "none";
                qrSection.style.display = "block";
            });
        }

        if(btnBackToInput) {
            btnBackToInput.addEventListener('click', function() {
                qrSection.style.display = "none";
                inputSection.style.display = "block";
                qrImage.src = "";
            });
        }
    });

    // ----------------------------------------------------
    // HÀM COPY TEXT CHUNG CHO CẢ MÃ ĐƠN HÀNG VÀ STK
    // ----------------------------------------------------
    function copyText(text, btnElement) {
        navigator.clipboard.writeText(text).then(function() {
            let originalText = btnElement.innerText;
            btnElement.innerText = "Đã Copy";
            btnElement.classList.remove("btn-outline-secondary");
            btnElement.classList.add("btn-success", "text-white");
            setTimeout(() => {
                btnElement.innerText = originalText;
                btnElement.classList.remove("btn-success", "text-white");
                btnElement.classList.add("btn-outline-secondary");
            }, 2000);
        });
    }
</script>
@model IEnumerable<Webdienlanh.Controllers.TechViewModel>

@{
    ViewData["Title"] = "BPV - Quản Lý Đội Ngũ Thợ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Lấy top 3 thợ có ví nhiều nhất để vẽ biểu đồ
    var topTechs = Model.OrderByDescending(t => t.WalletBalance).Take(3).ToList();
    var techNamesJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(topTechs.Select(t => t.Name)));
    var techWalletsJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(topTechs.Select(t => t.WalletBalance)));
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
        <div>
            <h2 class="fw-black text-dark mb-1">Quản Lý Kỹ Thuật Viên</h2>
            <p class="text-muted mb-0 fw-medium">Theo dõi hiệu suất, hồ sơ xác thực và số dư ví của toàn bộ đội ngũ thợ.</p>
        </div>
        <button class="btn bg-grad-primary text-white rounded-pill px-4 py-2 fw-bold shadow-sm border-0" data-bs-toggle="modal" data-bs-target="#createTechModal">
            <i class="bi bi-person-plus-fill me-2"></i>Thêm Thợ Mới
        </button>
    </div>

    <!-- THÔNG BÁO THÀNH CÔNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 bg-success text-white shadow-sm rounded-4 mb-4 fw-semibold p-3 d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: BIỂU ĐỒ BẢNG XẾP HẠNG -->
        <div class="col-xl-6">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i>Bảng Xếp Hạng Doanh Thu</h5>
                    <span class="badge bg-light text-muted border">Top Kỹ Thuật Viên</span>
                </div>
                <div class="chart-wrapper" style="height: 380px;">
                    <canvas id="topTechChart"></canvas>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: DANH SÁCH CHI TIẾT KÈM XEM HỒ SƠ & NẠP VÍ -->
        <div class="col-xl-6">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-dark mb-0">Hồ Sơ Kỹ Thuật Viên</h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">Tổng số: @Model.Count()</span>
                </div>

                <div class="overflow-auto pe-2" style="max-height: 380px;">
                    @foreach (var tech in Model)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 mb-3 bg-white rounded-4 border shadow-sm transition-hover">
                            <div class="d-flex align-items-center">
                                <img src="@tech.ImagePath" onerror="this.src='https://ui-avatars.com/api/?name=@tech.Name&background=random'" class="rounded-circle shadow-sm border border-2 border-white" style="width: 55px; height: 55px; object-fit: cover;">
                                <div class="ms-3">
                                    <h6 class="mb-1 fw-bold text-dark">@tech.Name</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-success small fw-semibold"><i class="bi bi-circle-fill" style="font-size:8px;"></i> Online</span>
                                        <span class="text-muted small">| <i class="bi bi-telephone-fill opacity-50 mx-1"></i> @tech.Phone</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end d-flex flex-column align-items-end">
                                <span class="fw-black text-dark fs-5 mb-1">@tech.WalletBalance.ToString("N0")<span class="fs-6 text-muted">₫</span></span>
                                <div class="d-flex gap-2 mt-1">
                                    <button class="btn btn-sm bg-primary bg-opacity-10 text-primary border-0 fw-bold rounded-pill px-3" onclick="openProfileModal('@tech.Name', '@tech.CCCD', '@tech.DOB', '@tech.Origin', '@tech.Address', '@tech.ImagePath')">
                                        <i class="bi bi-person-vcard me-1"></i> Hồ sơ
                                    </button>
                                    <button class="btn btn-sm btn-light border text-dark fw-bold rounded-pill px-3" onclick="openFundModal(@tech.Id, '@tech.Name', @tech.WalletBalance)">
                                        <i class="bi bi-wallet2 me-1"></i> Nạp ví
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 1: XEM HỒ SƠ CÁ NHÂN (CCCD) -->
<div class="modal fade" id="profileModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="bg-grad-primary p-4 text-center position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
                <img id="profileAvatar" src="" class="rounded-circle border border-4 border-white shadow" style="width: 100px; height: 100px; object-fit: cover; background: #fff;" />
                <h4 class="fw-black text-white mt-3 mb-0" id="profileName">Tên Thợ</h4>
                <span class="badge bg-white text-primary mt-2 shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Đã xác thực danh tính CCCD</span>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="bg-white rounded-4 p-3 shadow-sm border mb-3">
                    <p class="text-muted small fw-bold mb-1 text-uppercase"><i class="bi bi-credit-card-2-front me-2 text-primary"></i>Số Căn Cước Công Dân</p>
                    <h6 class="fw-black text-dark mb-0 fs-5" id="profileCCCD">---</h6>
                </div>
                <div class="bg-white rounded-4 p-3 shadow-sm border mb-3">
                    <p class="text-muted small fw-bold mb-1 text-uppercase"><i class="bi bi-calendar-event me-2 text-primary"></i>Ngày sinh</p>
                    <h6 class="fw-bold text-dark mb-0" id="profileDOB">---</h6>
                </div>
                <div class="bg-white rounded-4 p-3 shadow-sm border mb-3">
                    <p class="text-muted small fw-bold mb-1 text-uppercase"><i class="bi bi-geo-alt me-2 text-primary"></i>Quê quán</p>
                    <h6 class="fw-bold text-dark mb-0" id="profileOrigin">---</h6>
                </div>
                <div class="bg-white rounded-4 p-3 shadow-sm border">
                    <p class="text-muted small fw-bold mb-1 text-uppercase"><i class="bi bi-house me-2 text-primary"></i>Nơi thường trú</p>
                    <h6 class="fw-bold text-dark mb-0" id="profileAddress">---</h6>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 2: NẠP TIỀN VÀO VÍ -->
<div class="modal fade" id="fundModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-light border-0 p-4">
                <h5 class="modal-title fw-black text-dark"><i class="bi bi-wallet2 text-primary me-2"></i>Nạp Tiền Vào Ví Thợ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="AddFunds" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" id="modalTechId" name="technicianId" />
                    <div class="mb-4 text-center">
                        <h5 class="fw-bold text-dark mb-1" id="modalFundName">Tên Thợ</h5>
                        <p class="text-muted small mb-0">Số dư hiện tại: <span class="fw-bold text-success" id="modalCurrentBalance">0</span>₫</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Số tiền cần nạp (VNĐ)</label>
                        <div class="input-group input-group-lg border rounded-3 overflow-hidden shadow-sm">
                            <span class="input-group-text bg-white border-0 text-primary fw-bold">₫</span>
                            <input type="number" class="form-control border-0 fw-bold shadow-none" name="amount" required min="10000" step="10000" placeholder="VD: 500000">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn bg-grad-primary text-white fw-bold px-4 rounded-pill shadow-sm">Xác Nhận Nạp</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 3: THÊM THỢ MỚI -->
<div class="modal fade" id="createTechModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-light border-0 p-4">
                <h5 class="modal-title fw-black text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i>Thêm Kỹ Thuật Viên Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="CreateTech" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Họ và tên thợ</label>
                        <input type="text" class="form-control fw-bold shadow-sm" name="fullName" required placeholder="VD: Trần Văn A">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Số điện thoại</label>
                        <input type="text" class="form-control fw-bold shadow-sm" name="phone" required placeholder="VD: 0912345678">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Số dư ví ban đầu (VNĐ)</label>
                        <input type="number" class="form-control fw-bold shadow-sm" name="walletBalance" value="1000000" min="0" step="50000">
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-light border fw-bold px-4 rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn bg-grad-primary text-white fw-bold px-4 rounded-pill shadow-sm">Thêm Mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: all 0.2s ease;
    }

        .transition-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -5px rgba(0,0,0,0.1) !important;
            border-color: var(--primary) !important;
        }
</style>

@section Scripts {
    <script>
        // 1. BIỂU ĐỒ BẢNG XẾP HẠNG (BAR CHART)
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        const ctxTech = document.getElementById('topTechChart').getContext('2d');

        let gradBar = ctxTech.createLinearGradient(0, 0, 400, 0);
        gradBar.addColorStop(0, '#3b82f6');
        gradBar.addColorStop(1, '#4338ca');

        new Chart(ctxTech, {
            type: 'bar',
            data: {
                labels: @techNamesJson,
                datasets: [{
                    label: 'Số Dư Ví (VNĐ)',
                    data: @techWalletsJson,
                    backgroundColor: gradBar,
                    borderRadius: 8,
                    barThickness: 30
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) { label += ': '; }
                                if (context.parsed.x !== null) {
                                    label += new Intl.NumberFormat('vi-VN').format(context.parsed.x) + '₫';
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    x: { display: false },
                    y: { grid: { display: false }, border:{display: false}, ticks: { font: { weight: 'bold' }, color: '#334155' } }
                }
            }
        });

        // 2. MỞ MODAL XEM HỒ SƠ CCCD
        function openProfileModal(name, cccd, dob, origin, address, imgPath) {
            document.getElementById('profileName').innerText = name;
            document.getElementById('profileCCCD').innerText = cccd;
            document.getElementById('profileDOB').innerText = dob;
            document.getElementById('profileOrigin').innerText = origin;
            document.getElementById('profileAddress').innerText = address;

            let avatarImg = document.getElementById('profileAvatar');
            avatarImg.src = imgPath;
            avatarImg.onerror = function() { this.src = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(name) + '&background=random'; };

            new bootstrap.Modal(document.getElementById('profileModal')).show();
        }

        // 3. MỞ MODAL NẠP TIỀN VÀO VÍ
        function openFundModal(id, name, balance) {
            document.getElementById('modalTechId').value = id;
            document.getElementById('modalFundName').innerText = name;
            document.getElementById('modalCurrentBalance').innerText = new Intl.NumberFormat('vi-VN').format(balance);

            new bootstrap.Modal(document.getElementById('fundModal')).show();
        }
    </script>
}